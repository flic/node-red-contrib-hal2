[
    {
        "id": "ex-emit-tab",
        "type": "tab",
        "label": "hal2 emit to MQTT",
        "disabled": false,
        "info": "Example: publish hal2's state changes to an external subscriber with the **hal2Emit** node.\n\nThe emit node listens on the Event handler and sends one envelope per matching update — `{v, type:\"event\", site, boot, seq, ts, thing, item, new, old, last_change}` — with `msg.topic` built from its template, here `hal2/home/event/<room>/<thing>/<item>`.\n\nA Thing without a room gets `_` in that place. Its two filter rows send every **light** and every **motion** item, on change only, whichever Thing it belongs to: add a lamp and it is published without touching this node.\n\nSet a broker on the `mqtt out` node to publish; the debug node shows the envelopes either way. The inject nodes stand in for the devices' own reports."
    },
    {
        "id": "ex-emit-eh",
        "type": "hal2EventHandler",
        "name": "Event handler",
        "locationName": "Home",
        "maxlisteners": "50",
        "heartbeat": "3600"
    },
    {
        "id": "ex-emit-tt-light",
        "type": "hal2ThingType",
        "name": "Lamp",
        "contextStore": "",
        "nodestatus": "%On%",
        "nodestatusType": "str",
        "statusFn": "",
        "items": [
            {
                "name": "On",
                "id": "on",
                "topicFilters": [],
                "topicFilterMode": "and",
                "topicSuffix": "/set",
                "type": "both",
                "haType": "light",
                "ingress": "ex-pass",
                "egress": "ex-egress",
                "notes": "",
                "tags": [],
                "output": "1",
                "history": false,
                "historyAllUpdates": false
            }
        ],
        "attributes": [],
        "metadata": [],
        "ingress": [
            {
                "id": "ex-pass",
                "name": "Pass-through",
                "fn": "// The sensor publishes true/false as the payload.\nreturn msg.payload;"
            }
        ],
        "egress": [
            {
                "id": "ex-egress",
                "name": "Pass-through",
                "fn": "return msg;"
            }
        ],
        "thingStatus": true,
        "thingCommand": true,
        "thingOutput": true,
        "outputs": 1,
        "hbCheck": false,
        "hbType": "lwt",
        "hbTTL": 3600,
        "hbLWT": "",
        "hbFilters": []
    },
